# Copy to .env and change what you need. Bun loads .env automatically. Never commit .env or data/.

# Where the dashboard listens. Keep 127.0.0.1 unless a reverse proxy on another host must reach it.
HOST=127.0.0.1
PORT=4310
AUTH_MODE=local
# The address people open, for example https://dashboard.example.com behind your HTTPS reverse proxy.
# APP_ORIGIN=http://127.0.0.1:4310
# APP_NAME=Agentic Dashboard

# Records, keys and audio live here (default: data/dashboard.sqlite and data/credentials.json).
# DATA_DIR=data

# Calendar days (Today, digests, daily limits) use this IANA zone; defaults to the host's zone.
# TIME_ZONE=Europe/Berlin
# Language of push notifications (en or ko). The web app follows the browser and can be switched in Settings.
# LOCALE=en

# Optional sign-in through an identity-aware reverse proxy (for example Tailscale Serve).
# Only enable it when the proxy strips this header from client requests and is the only way in.
# TRUSTED_USER_HEADER=Tailscale-User-Login
# OWNER_LOGIN=you@example.com

# Optional features. A default install needs no external keys.
# PUSH=on                      # web push; VAPID keys are generated on first use in data/vapid.json
# DIGEST=on                    # agents upload news/mail-style digests to the Digest tab
# GEMINI_API_KEY=              # turns on "Listen" (text to speech) for records
# NARRATION_VOICE=Kore
# NARRATION_PODCAST_VOICE=Puck   # podcast host B; host A is NARRATION_VOICE
# NARRATION_DAILY_LIMIT=20     # local default 20; Google-mode default 10
# OWNER_USER_LIMITS={"operator-user-id":20}
# NARRATION_GLOBAL_DAILY_LIMIT=60
# NARRATION_TTS_PROVIDER=vertex       # make the audio on Vertex AI with Application Default Credentials instead of the key
# NARRATION_VERTEX_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json   # default: ~/.config/gcloud/...
# AI_FILL_COMMAND=llm -m gpt-4o-mini   # any CLI that reads a prompt on stdin and prints JSON; tidies captured link titles
# AI_FILL_SOURCES=                     # agents whose saves are tidied too, comma separated

# Local MCP endpoint on 127.0.0.1:MCP_PORT. Every request requires an agent bearer; MCP_AGENT does not authenticate callers.
# ENABLE_MCP=false
# MCP_PORT=4313
# MCP_AGENT=chat-assistant

# Public read-only demo: anyone browses as the owner and every change answers 403. Only for demo data; see docs/demo.md.
# DEMO=off

# A separate listener that only accepts agent record saves and reads, for exposing agents without the owner UI.
# ENABLE_AGENT_INGRESS=false
# AGENT_PORT=4312

# Automatic audio: new/edited research, work reports, notes and links; changeable in Settings.
# NARRATION_RECORD_AUTO=read          # off | read | podcast
# NARRATION_DIGEST_AUTO=off           # off | parts | all; independent of record audio
# NARRATION_CONCURRENCY=2             # 1..4 jobs; a record never runs twice at once
# NARRATION_SCRIPT_MODEL=gemini-4-argon        # Vertex script route
# NARRATION_KEY_SCRIPT_MODEL=gemini-3.8-flash  # AI Studio key route
# Encoding: ffmpeg from PATH, otherwise macOS afconvert, otherwise WAV.

# Optional shared SQL backend; a local path/file: URL uses SQLite. Remote tokens stay outside the repository.
# DATABASE_URL=libsql://your-database.example.com
# DATABASE_AUTH_TOKEN=

# Optional hosted accounts: see docs/hosted-auth.md. Do not commit real secrets.
# AUTH_MODE=google
# APP_ORIGIN=https://dashboard.example.com
# MAX_USERS=50
# Google mode only; default on in Cloud Run (K_SERVICE), off elsewhere.
# AUTH_TRUST_PROXY=on
# Set off to disable forwarded-header trust; local mode always uses the socket.
# APP_SECRETS={"google":{"clientId":"<client-id>","clientSecret":"<client-secret>"},"sessionSigningKey":"<independent-random-secret>","kek":{"1":"<32-byte-base64-key>"},"vapid":{"publicKey":"<public-key>","privateKey":"<private-key>"}}
# AI_FILL_MODEL=gemini-3.5-flash-lite
# OWNER_ALERT_EMAIL=operator@example.com
# CONTACT_EMAIL=operator@example.com
# AUDIO_BUCKET=
# TASKS_QUEUE=
# TASKS_SERVICE_ACCOUNT=
