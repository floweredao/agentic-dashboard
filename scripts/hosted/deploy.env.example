# Copy OUTSIDE the checkout to ~/.config/dash-web/deploy.env and chmod 600.
# Plain dotenv assignments, not shell code. No credentials belong in this file.
PROJECT_ID=example-project
BILLING_ACCOUNT=000000-000000-000000
REGION=us-central1
SERVICE=dashboard
SA=dashboard
REPOSITORY=dashboard
SECRET=dash-web-config
BUCKET=example-dashboard
QUEUE=dashboard
TURSO_DB=example-dashboard
# An existing group in your logged-in Turso organization.
TURSO_GROUP=default
# Leave these absent to discover them during deploy:
# APP_ORIGIN=https://dashboard.example.com
# DATABASE_URL=libsql://database.example.com
OWNER_ALERT_EMAIL=owner@example.com
CONTACT_EMAIL=contact@example.com
MAX_USERS=50
NARRATION_DAILY_LIMIT=10
NARRATION_GLOBAL_DAILY_LIMIT=60
OWNER_USER_LIMITS={}
