{
  "name": "agentic-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentic-dashboard": "cli/main.ts"
  },
  "files": [
    "cli",
    "server",
    "shared",
    "scripts/agent.ts",
    "scripts/agent-client.ts",
    "scripts/agents.ts",
    "skills",
    "dist",
    "install.sh",
    ".env.example",
    "CONTRACT.md",
    "CHANGELOG.md",
    "README.ko.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "prepack": "vite build",
    "dev": "vite --host 127.0.0.1",
    "setup": "bun scripts/setup.ts",
    "start": "bun server/index.ts",
    "agents": "bun scripts/agents.ts",
    "agent": "bun scripts/agent.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:binary": "vite build && bun scripts/build-binary.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "ky": "^1.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "typescript-language-server": "^6.0.0",
    "vite": "^7.1.4"
  },
  "description": "A self-hosted, mobile-first dashboard where your AI agents file research, work reports, notes and links for you to review.",
  "license": "MIT"
}
